# LLM provider configuration
# Copy this file to .env and set values for your provider.
# If no .env file exists, the app defaults to Ollama on localhost:11434.

# --- Ollama (default, no .env needed) ---
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=Gemma4E4B:latest

# --- LMStudio ---
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_API_KEY=lm-studio
# LLM_MODEL=<model-identifier-shown-in-lmstudio-server-panel>

# ---------------------------------------------------------------------------
# Character list source strategy
# ---------------------------------------------------------------------------
# Controls how the character list is obtained during book loading.
#
#   wiki        - Fetch from Wikipedia (original behaviour).
#                 Best for well-known novels with English Wikipedia pages.
#
#   txt_extract - Sample the local TXT file (head / middle / tail) and use
#                 the LLM to extract character names.
#                 Best for local Chinese web novels or any book not on Wikipedia.
#
#   auto        - Try Wikipedia first; if it returns 0 results, automatically
#                 fall back to txt_extract. (DEFAULT)
#
# This setting is the global default. It can also be overridden per-request
# by passing "character_source" in the /api/load-book or /api/upload-book body.
# ---------------------------------------------------------------------------
# CHARACTER_SOURCE=auto
